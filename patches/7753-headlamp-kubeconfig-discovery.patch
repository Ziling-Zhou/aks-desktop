From 92057fc35c9e7d57c87ec737ced4ffbaecbda085 Mon Sep 17 00:00:00 2001
From: Ziling Zhou <zilingzhou@microsoft.com>
Date: Fri, 13 Nov 2026 15:42:17 -0800
Subject: [PATCH 2/3] backend: kubeconfig: Accept null contexts and reconcile
 removed files

client-go writes an empty context list as null, for example after the last
context is pruned, so treat null contexts as none rather than invalid. Skip a
missing kubeconfig while other listed files are readable, and reconcile
removals as well as additions when a watched file is replaced or removed
before its watch is attached.
---
 backend/pkg/kubeconfig/discovery_test.go | 143 +++++++++++++++++++++++
 backend/pkg/kubeconfig/kubeconfig.go     |  26 ++++-
 backend/pkg/kubeconfig/watcher.go        |  12 +-
 3 files changed, 178 insertions(+), 3 deletions(-)
 create mode 100644 backend/pkg/kubeconfig/discovery_test.go

diff --git a/backend/pkg/kubeconfig/discovery_test.go b/backend/pkg/kubeconfig/discovery_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..80c76d852bea6e58b1512fff98340d93b4abdc66
--- /dev/null
+++ b/backend/pkg/kubeconfig/discovery_test.go
@@ -0,0 +1,143 @@
+package kubeconfig_test
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/kubernetes-sigs/headlamp/backend/pkg/kubeconfig"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"k8s.io/client-go/tools/clientcmd"
+	clientcmdapi "k8s.io/client-go/tools/clientcmd/api"
+)
+
+func writeDiscoveryConfig(t *testing.T, file, name string) {
+	t.Helper()
+
+	config := clientcmdapi.Config{
+		Clusters: map[string]*clientcmdapi.Cluster{
+			name: {Server: "https://127.0.0.1:65535", InsecureSkipTLSVerify: true},
+		},
+		AuthInfos: map[string]*clientcmdapi.AuthInfo{
+			name: {Token: "synthetic-discovery-test-token"},
+		},
+		Contexts: map[string]*clientcmdapi.Context{
+			name: {Cluster: name, AuthInfo: name},
+		},
+		CurrentContext: name,
+	}
+	require.NoError(t, clientcmd.WriteToFile(config, file))
+}
+
+func TestDiscoveryWithMissingKubeconfigPaths(t *testing.T) {
+	for _, missingFirst := range []bool{false, true} {
+		name := "missing-last"
+		if missingFirst {
+			name = "missing-first"
+		}
+
+		t.Run(name, func(t *testing.T) {
+			root := t.TempDir()
+			existing := filepath.Join(root, "ordinary-config")
+			missing := filepath.Join(root, "private-config")
+			writeDiscoveryConfig(t, existing, "ordinary")
+			paths := []string{existing, missing}
+			if missingFirst {
+				paths = []string{missing, existing}
+			}
+
+			contexts, contextErrors, err := kubeconfig.LoadContextsFromMultipleFiles(
+				strings.Join(paths, string(os.PathListSeparator)), kubeconfig.KubeConfig)
+			require.NoError(t, err)
+			require.Empty(t, contextErrors)
+			require.Len(t, contexts, 1)
+			require.Equal(t, "ordinary", contexts[0].Name)
+			require.Equal(t, existing, contexts[0].KubeConfigPath)
+
+			writeDiscoveryConfig(t, missing, "private")
+			contexts, contextErrors, err = kubeconfig.LoadContextsFromMultipleFiles(
+				strings.Join(paths, string(os.PathListSeparator)), kubeconfig.KubeConfig)
+			require.NoError(t, err)
+			require.Empty(t, contextErrors)
+			require.Len(t, contexts, 2)
+		})
+	}
+}
+
+func TestDiscoveryDoesNotHideAllMissingOrInvalidFiles(t *testing.T) {
+	root := t.TempDir()
+	existing := filepath.Join(root, "ordinary-config")
+	writeDiscoveryConfig(t, existing, "ordinary")
+	missing := filepath.Join(root, "missing-config")
+	missingPaths := strings.Join([]string{missing, missing + "-second"}, string(os.PathListSeparator))
+	_, _, err := kubeconfig.LoadContextsFromMultipleFiles(missingPaths, kubeconfig.KubeConfig)
+	require.ErrorIs(t, err, os.ErrNotExist)
+
+	invalid := filepath.Join(root, "invalid-config")
+	require.NoError(t, os.WriteFile(invalid, []byte("contexts: [invalid"), 0o600))
+
+	for _, invalidPath := range []string{invalid, root} {
+		paths := strings.Join([]string{existing, invalidPath}, string(os.PathListSeparator))
+		_, _, err := kubeconfig.LoadContextsFromMultipleFiles(paths, kubeconfig.KubeConfig)
+		require.Error(t, err)
+		require.False(t, errors.Is(err, os.ErrNotExist))
+	}
+}
+
+func TestDiscoveryWatcherReconcilesUnobservedRemoval(t *testing.T) {
+	for _, ordinaryExists := range []bool{true, false} {
+		name := "ordinary-absent"
+		if ordinaryExists {
+			name = "ordinary-present"
+		}
+
+		t.Run(name, func(t *testing.T) {
+			root := t.TempDir()
+			ordinary := filepath.Join(root, "ordinary-config")
+			private := filepath.Join(root, "private-config")
+			var expected []string
+
+			if ordinaryExists {
+				writeDiscoveryConfig(t, ordinary, "ordinary")
+				expected = append(expected, "ordinary")
+			}
+
+			writeDiscoveryConfig(t, private, "private")
+			paths := strings.Join([]string{ordinary, private}, string(os.PathListSeparator))
+			store := kubeconfig.NewContextStore()
+			require.NoError(t, kubeconfig.LoadAndStoreKubeConfigs(store, paths, kubeconfig.KubeConfig, nil))
+			_, err := store.GetContext("private")
+			require.NoError(t, err)
+
+			// No file event can be observed for a removal before the watch is attached.
+			require.NoError(t, os.Remove(private))
+			ctx, cancel := context.WithCancel(context.Background())
+			stopped := make(chan struct{})
+
+			go func() {
+				defer close(stopped)
+				kubeconfig.LoadAndWatchFiles(ctx, store, paths, kubeconfig.KubeConfig, nil)
+			}()
+
+			t.Cleanup(func() {
+				cancel()
+				<-stopped
+			})
+
+			require.EventuallyWithT(t, func(collect *assert.CollectT) {
+				contexts, err := store.GetContexts()
+				require.NoError(collect, err)
+				var actual []string
+				for _, current := range contexts {
+					actual = append(actual, current.Name)
+				}
+				require.ElementsMatch(collect, expected, actual)
+			}, 20*time.Second, 100*time.Millisecond)
+		})
+	}
+}
diff --git a/backend/pkg/kubeconfig/kubeconfig.go b/backend/pkg/kubeconfig/kubeconfig.go
index 99e2ff6b4d8348bd8e19a3d8ec8acdd393f10939..ed1e2ee5aeaf5a9212bf322e8e89f0a2188230e7 100644
--- a/backend/pkg/kubeconfig/kubeconfig.go
+++ b/backend/pkg/kubeconfig/kubeconfig.go
@@ -602,10 +602,19 @@ func LoadContextsFromMultipleFiles(kubeConfigs string, source int) ([]Context, [
 
 	var contextErrors []ContextLoadError
 
+	var missingFiles []error
+
 	kubeConfigPaths := splitKubeConfigPath(kubeConfigs)
 	for _, kubeConfigPath := range kubeConfigPaths {
 		kubeConfigContexts, errs, err := LoadContextsFromFile(kubeConfigPath, source)
 		if err != nil {
+			// A newly registered file may not exist yet; do not hide readable files.
+			if errors.Is(err, os.ErrNotExist) {
+				missingFiles = append(missingFiles, err)
+
+				continue
+			}
+
 			return nil, nil, err
 		}
 
@@ -613,6 +622,14 @@ func LoadContextsFromMultipleFiles(kubeConfigs string, source int) ([]Context, [
 		contextErrors = append(contextErrors, errs...)
 	}
 
+	if len(missingFiles) == len(kubeConfigPaths) {
+		return nil, nil, errors.Join(missingFiles...)
+	}
+
+	for _, err := range missingFiles {
+		logger.Log(logger.LevelInfo, nil, err, "skipping absent kubeconfig alongside readable files")
+	}
+
 	return contexts, contextErrors, nil
 }
 
@@ -677,7 +694,14 @@ func UnmarshalKubeconfig(data []byte) (map[string]interface{}, error) {
 
 // GetContextsFromKubeconfig gets the contexts from the kubeconfig.
 func GetContextsFromKubeconfig(kubeconfig map[string]interface{}) ([]interface{}, error) {
-	rawContexts, ok := kubeconfig["contexts"].([]interface{})
+	value, present := kubeconfig["contexts"]
+	// client-go writes an empty context list as null, for example after the last context is
+	// deleted or pruned; that file has no contexts rather than invalid ones.
+	if present && value == nil {
+		return []interface{}{}, nil
+	}
+
+	rawContexts, ok := value.([]interface{})
 	if !ok {
 		return nil, DataError{Field: "contexts", Reason: "invalid or missing contexts in kubeconfig"}
 	}
diff --git a/backend/pkg/kubeconfig/watcher.go b/backend/pkg/kubeconfig/watcher.go
index 34a7e1e5d205a93e7b73b9cc4195d3a36ab40cfb..8d98f70ef2232fb8f3db3ae5f67124acafdf4319 100644
--- a/backend/pkg/kubeconfig/watcher.go
+++ b/backend/pkg/kubeconfig/watcher.go
@@ -53,6 +53,12 @@ func LoadAndWatchFiles(
 	// add files to watcher
 	addFilesToWatcher(watcher, kubeConfigPaths)
 
+	// No file event reports a change made before the watch was attached, such as a removed
+	// kubeconfig, so reconcile the store once now.
+	if err := syncContexts(kubeConfigStore, paths, source, ignoreFunc); err != nil {
+		logger.Log(logger.LevelError, nil, err, "watcher: error synchronizing contexts")
+	}
+
 	for {
 		select {
 		case <-ctx.Done():
@@ -106,9 +112,11 @@ func reAddMissingFiles(
 
 	logger.Log(logger.LevelInfo, nil, nil, "watcher: re-added missing files")
 
-	err := LoadAndStoreKubeConfigs(kubeConfigStore, existingKubeConfigPaths(paths), source, ignoreFunc)
+	// Atomic replacement can leave a gap before the file watch is reattached, so reconcile
+	// removals as well as additions.
+	err := syncContexts(kubeConfigStore, paths, source, ignoreFunc)
 	if err != nil {
-		logger.Log(logger.LevelError, nil, err, "watcher: error loading kubeconfig files")
+		logger.Log(logger.LevelError, nil, err, "watcher: error synchronizing contexts")
 	}
 }
 
